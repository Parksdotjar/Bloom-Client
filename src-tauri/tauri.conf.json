{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bloom Client",
  "version": "1.2.1",
  "identifier": "com.bloomunit.client",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Bloom Client",
        "width": 1400,
        "height": 900,
        "decorations": false,
        "transparent": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "fileAssociations": [
      {
        "ext": ["bloom"],
        "name": "Bloom Modpack",
        "description": "Bloom Client modpack archive",
        "mimeType": "application/x-bloom-modpack"
      }
    ],
    "resources": [
      "icons/bloom_taskbar_icon.ico"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "./windows/hooks.nsh"
      },
      "wix": {
        "fragmentPaths": [
          "./windows/fragments/bloom-file-association.wxs"
        ],
        "componentRefs": [
          "BloomFileAssociationRegistry"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Parksdotjar/Bloom-Client/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDA0RjgxOTdGQzE2QUFBRDQKUldUVXFtckJmeG40QkZBekpvUkdCU3FVeTBKSHhJZzdPZFdDeFpqSjZ5MXZvRUYzYnFPSUNiUXMK"
    }
  }
}





