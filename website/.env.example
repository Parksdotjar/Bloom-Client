VITE_SITE_URL=https://bloomclient.org
VITE_BASE_PATH=/

# Point this at the public latest.json object in Supabase Storage for live downloads.
# Example: https://YOUR_PROJECT_REF.supabase.co/storage/v1/object/public/updates/latest.json
VITE_UPDATES_JSON_URL=/latest.json
VITE_SKS_UPDATES_JSON_URL=/sks-latest.json

# Optional Supabase news feed
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional override for the public support checkout Edge Function base.
# Defaults to VITE_SUPABASE_URL/functions/v1/support.
VITE_SUPABASE_SUPPORT_FUNCTION_URL=
# Optional override for the BUD license dashboard Edge Function base.
# Defaults to VITE_SUPABASE_URL/functions/v1/bud-license.
VITE_SUPABASE_BUD_FUNCTION_URL=
VITE_SUPABASE_FUNCTIONS_URL=
VITE_SUPABASE_NEWS_TABLE=news_posts
VITE_SUPABASE_NEWS_FIELDS=id,title,slug,summary,published_at
VITE_SUPABASE_NEWS_ORDER_COLUMN=published_at
VITE_SUPABASE_NEWS_PUBLISHED_COLUMN=is_published
VITE_SUPABASE_NEWS_LIMIT=8

# Server-side Edge Function secrets only. Do not prefix these with VITE_.
# Set them in Supabase Edge Function secrets, not in browser builds.
MCSETS_BUD_MONTHLY_PRICE_ID=
MCSETS_BUD_SUCCESS_URL=
MCSETS_BUD_CANCEL_URL=
MCSETS_WEBHOOK_SECRET=
